{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@buzz/author": [
        ".buzz-author/types/plugins/author.d.ts"
      ],
      "@buzz/author/*": [
        ".buzz-author/types/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
